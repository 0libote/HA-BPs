---
import HABase from '../../layouts/HABase.astro';
import Icon from '../../components/Icon.astro';
import { blueprints, shortBlurb, bpNeeds, bpIcon } from '../../lib/blueprints';
---
<HABase title="Docs — blueprint setup guides and references" active="docs">
  <div class="masthead">
    <p class="kicker">Docs</p>
    <h1>Setup guides and references.</h1>
    <p class="lede">
      Each page pairs a setup guide with an input reference generated from the blueprint
      YAML — every field, default and selector type — plus troubleshooting and the source.
    </p>
  </div>

  <div class="bp-list">
    {blueprints.map((b) => (
      <article class="bp-row">
        <div class="ric"><Icon name={bpIcon[b.slug] ?? 'book'} size={20} /></div>
        <div>
          <h2 class="bp-name"><a href={`/docs/${b.slug}`}>{b.name}</a></h2>
          <p class="bp-desc">{shortBlurb[b.slug] ?? ''}</p>
          <p class="bp-needs">Needs: {bpNeeds[b.slug] ?? b.domain}</p>
          <div class="bp-links">
            <a href={`/docs/${b.slug}`}>Read the guide</a>
            <a href={`/showcase/${b.slug}`}>Showcase</a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <h2 class="h-sec">Manual install</h2>
  <div class="prose">
    <p>
      If URL import is unavailable, download the YAML into
      <code class="inline">/config/blueprints/automation/0libote/</code>,
      reload automations, then create the automation from the installed blueprint.
    </p>
  </div>
</HABase>
