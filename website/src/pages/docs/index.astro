---
import HABase from '../../layouts/HABase.astro';
import Icon from '../../components/Icon.astro';
import { blueprints, shortBlurb, bpNeeds, bpIcon } from '../../lib/blueprints';
---
<HABase title="Docs — blueprint setup guides and references" active="docs">
  <div class="masthead">
    <p class="kicker">Docs</p>
    <h1>Setup guides and references.</h1>
    <p class="lede">
      Each page pairs a setup guide with an input reference generated from the blueprint
      YAML — every field, default and selector type — plus troubleshooting and the source.
    </p>
  </div>

  <div class="bp-list">
    {blueprints.map((b) => (
      <article class="bp-row">
        <div class="ric"><Icon name={bpIcon[b.slug] ?? 'book'} size={20} /></div>
        <div>
          <h2 class="bp-name"><a href={`/docs/${b.slug}`}>{b.name}</a></h2>
          <p class="bp-desc">{shortBlurb[b.slug] ?? ''}</p>
          <p class="bp-needs">Needs: {bpNeeds[b.slug] ?? b.domain}</p>
          <div class="bp-links">
            <a href={`/docs/${b.slug}`}>Read the guide</a>
            <a href={`/showcase/${b.slug}`}>Showcase</a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <h2 class="h-sec">Use them together</h2>
  <div class="prose">
    <p>BILRESA provides manual control, MYGGSPRAY owns the motion sessions it starts,
      and Forgot to Turn Off supplies a longer passive safety timeout.</p>
    <p>For reliable manual priority, create a Toggle helper and select it under
      <strong>Manual Override Helpers</strong> in both BILRESA and MYGGSPRAY.
      A remote gesture sets it ON before changing lights. Turn it OFF to allow
      fresh motion to start a session again. The passive safety timeout still applies.</p>
    <p>Use the same room sensors and choose a safety timeout longer than the motion
      clear delay. Faults release motion control without switching an occupied room off.</p>
    <p><a href="https://github.com/0libote/HA-BPs/blob/main/blueprints/README.md#using-the-blueprints-together">Integration and upgrade guide</a>
      · <a href="https://github.com/0libote/HA-BPs/blob/main/docs/automation-review.md">Engineering review</a></p>
  </div>

  <h2 class="h-sec">Manual install</h2>
  <div class="prose">
    <p>
      If URL import is unavailable, download the YAML into
      <code class="inline">/config/blueprints/automation/0libote/</code>,
      reload automations, then create the automation from the installed blueprint.
    </p>
  </div>
</HABase>
