---
import HABase from '../../layouts/HABase.astro';
import Icon from '../../components/Icon.astro';
import { blueprints, getBlueprint } from '../../lib/blueprints';
import { md } from '../../lib/markdown';

export function getStaticPaths() {
  return blueprints.map((b) => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
const bp = getBlueprint(slug ?? '');
if (!bp) throw new Error(`Unknown blueprint: ${slug}`);
const guideHtml = md(bp.docsMarkdown || 'No guide yet.');
---
<HABase title={`${bp.name} — docs`} active="docs">
  <div class="crumb-row">
    <a class="link-quiet" href="/docs"><Icon name="arrowLeft" size={14} /> All docs</a>
    <div class="links">
      <a class="link-quiet" href={`/showcase/${bp.slug}`}>Showcase</a>
      <a class="ha-btn small" href={bp.importUrl} target="_blank" rel="noreferrer"><Icon name="download" size={14} /> Import in HA</a>
    </div>
  </div>

  <div class="masthead">
    <p class="kicker">Docs<span class="sep">/</span><span class="mono">{bp.file}</span></p>
    <h1>{bp.name}</h1>
    <p class="meta-line">{bp.domain} · HA {bp.min_version}+ · {bp.fieldCount} inputs</p>
  </div>

  <div class="prose" style="margin-top: 16px; white-space: pre-wrap;">{bp.description}</div>
  <p class="small muted">Manual import URL: <code class="inline">{bp.manualUrl}</code></p>

  <h2 class="h-sec">Setup guide</h2>
  <div class="prose" set:html={guideHtml} />

  <h2 class="h-sec">Input reference</h2>
  <p class="sub">Every field, default and selector — generated from the YAML at build time.</p>
  {bp.sections.map((s) => (
    <div style="margin-top: 18px;">
      <b>{s.name}</b> <span class="small muted mono">{s.key} · {s.collapsed ? 'collapsed' : 'open'} by default</span>
      <table class="ha-table">
        <thead><tr><th>Input</th><th>Selector</th><th>Default</th></tr></thead>
        <tbody>
          {s.fields.map((f) => (
            <tr>
              <td><b>{f.name}</b><br /><span class="small muted"><code class="inline">{f.key}</code><br />{f.description?.slice(0, 140)}</span></td>
              <td><code class="inline">{f.selectorType}</code></td>
              <td class="small muted"><code class="inline">{JSON.stringify(f.default)?.slice(0, 80) ?? '—'}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ))}

  <h2 class="h-sec">Source</h2>
  <p class="sub">Full blueprint — also on <a href={bp.githubUrl} target="_blank" rel="noreferrer">GitHub</a>.</p>
  <pre class="ha-pre">{bp.rawYaml.slice(0, 6000)}{bp.rawYaml.length > 6000 ? '\n… (truncated — see GitHub for full file)' : ''}</pre>
</HABase>
