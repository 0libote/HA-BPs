---
import HABase from '../layouts/HABase.astro';
import Icon from '../components/Icon.astro';
import { blueprints, shortBlurb, bpNeeds, bpIcon } from '../lib/blueprints';
---
<HABase title="0libote blueprints — Home Assistant blueprints for IKEA Matter devices" active="blueprints">
  <div class="masthead">
    <p class="kicker">Home Assistant blueprints<span class="sep">/</span>by 0libote</p>
    <h1>Automations for IKEA Matter gear.</h1>
    <p class="lede">
      Four blueprints: a doorbell announcer, a BILRESA scroll-wheel light controller,
      MYGGSPRAY motion lights, and a passive safety net for lights left on.
      Each is tested in CI against real Home Assistant — YAML lint, input wiring,
      and schema validation.
    </p>
    <p class="lede">
      Import one below, or open its showcase first: a working copy of HA's blueprint
      editor with mock entities, so you can try every setting before touching your home.
    </p>
  </div>

  <div class="bp-list">
    {blueprints.map((b) => (
      <article class="bp-row">
        <div class="ric"><Icon name={bpIcon[b.slug] ?? 'sliders'} size={20} /></div>
        <div>
          <h2 class="bp-name"><a href={`/docs/${b.slug}`}>{b.name}</a></h2>
          <p class="bp-desc">{shortBlurb[b.slug] ?? b.description.split('\n')[0]}</p>
          <p class="bp-needs">Needs: {bpNeeds[b.slug] ?? b.domain}</p>
          <div class="bp-links">
            <a href={`/docs/${b.slug}`}>Docs</a>
            <a href={`/showcase/${b.slug}`}>Showcase</a>
            <a href={b.githubUrl} target="_blank" rel="noreferrer">Source</a>
          </div>
        </div>
        <div class="act">
          <a class="ha-btn small" href={b.importUrl} target="_blank" rel="noreferrer"><Icon name="download" size={14} /> Import</a>
        </div>
      </article>
    ))}
  </div>

  <h2 class="h-sec">Install</h2>
  <div class="prose">
    <p>
      Press <b>Import</b> on any blueprint above. It opens the blueprint preview on your own
      instance via My Home Assistant. Then go to Settings → Automations &amp; scenes → Blueprints →
      Create automation, and pick your entities.
    </p>
    <p>
      Without My Home Assistant, download the YAML file into
      <code class="inline">/config/blueprints/automation/0libote/</code>,
      reload automations, and create the automation from the installed blueprint.
      Keep the same filename when updating. To update an import, use the three-dot
      menu beside the blueprint → Re-import blueprint.
    </p>
  </div>

  <h2 class="h-sec">Support</h2>
  <div class="prose">
    <p>
      Something wrong? <a href="https://github.com/0libote/HA-BPs/issues/new" target="_blank" rel="noreferrer">Open an issue</a> with
      the blueprint name, your Home Assistant version, how the device is connected,
      and an automation trace or log message. Strip secrets and personal entity names first.
    </p>
  </div>
</HABase>
