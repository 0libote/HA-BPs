---
import HABase from '../../layouts/HABase.astro';
import Icon from '../../components/Icon.astro';
import ShowcaseApp from '../../components/ha/ShowcaseApp';
import { blueprints, getBlueprint } from '../../lib/blueprints';
import '../../styles/ha-app.css';

export function getStaticPaths() {
  return blueprints.map((b) => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
const bp = getBlueprint(slug ?? '');
if (!bp) throw new Error(`Unknown blueprint: ${slug}`);
---
<HABase title={`${bp.name} — showcase`} active="showcase" wide>
  <div class="crumb-row">
    <a class="link-quiet" href="/showcase"><Icon name="arrowLeft" size={14} /> All blueprints</a>
    <div class="links">
      <a class="link-quiet" href={`/docs/${bp.slug}`}>Docs</a>
      <a class="ha-btn small" href={bp.importUrl} target="_blank" rel="noreferrer"><Icon name="download" size={14} /> Import in HA</a>
    </div>
  </div>

  <div class="masthead">
    <p class="kicker">Showcase<span class="sep">/</span><span class="mono">{bp.file}</span></p>
    <h1>{bp.name}</h1>
  </div>

  <ShowcaseApp blueprint={bp} client:load />

  <p class="footnote">
    Sections open and collapse exactly as declared in <span class="mono">{bp.file}</span>.
    Entity pickers only list domains the blueprint's filter allows. The YAML panel shows
    what HA would store for an automation built from this blueprint.
  </p>
</HABase>
