---
import HABase from '../../layouts/HABase.astro';
import Icon from '../../components/Icon.astro';
import { blueprints, shortBlurb, bpIcon } from '../../lib/blueprints';
---
<HABase title="Showcase — try every blueprint setting" active="showcase" wide>
  <div class="masthead">
    <p class="kicker">Showcase</p>
    <h1>Try before you import.</h1>
    <p class="lede">
      Each showcase is a working copy of HA's blueprint editor for that blueprint —
      the same sections, fields, defaults and selector types, running on mock entities.
      Configure, watch the automation YAML update, then import for real.
    </p>
  </div>

  <div class="bp-list">
    {blueprints.map((b) => (
      <article class="bp-row">
        <div class="ric"><Icon name={bpIcon[b.slug] ?? 'sliders'} size={20} /></div>
        <div>
          <h2 class="bp-name"><a href={`/showcase/${b.slug}`}>{b.name}</a></h2>
          <p class="bp-desc">{shortBlurb[b.slug] ?? ''}</p>
          <p class="bp-needs">{b.sections.map((s) => s.name).join(' · ')}</p>
          <div class="bp-links">
            <a href={`/showcase/${b.slug}`}>Open showcase</a>
            <a href={`/docs/${b.slug}`}>Docs</a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <p class="footnote">
    The replica is generated from the blueprint YAML at build time
    (<span class="mono">bun run data:build</span> parses sections, fields, defaults and selector
    configs), so it cannot drift from the real editor. Collapsed sections, domain filters
    and colour lists all match. Nothing here controls a real home.
  </p>
</HABase>
