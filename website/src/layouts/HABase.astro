---
import '../styles/ha.css';

interface Props {
  title: string;
  crumbs?: string;
  heading?: string;
  active?: 'home' | 'docs' | 'showcase';
}

const { title, crumbs = '0libote · Home Assistant Blueprints', heading, active = 'home' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Practical Home Assistant blueprints for IKEA Matter devices — with live 1:1 config showcase, docs and one-click import." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="ha-app">
      <aside class="ha-sidebar">
        <div class="ha-brand">
          <div class="ha-logo">⌂</div>
          <div><b>0libote BPs</b><span>HA blueprints · Matter-first</span></div>
        </div>
        <nav class="ha-nav">
          <a href="/" class={active === 'home' ? 'active' : ''}><span class="ico">◈</span> Overview</a>
          <a href="/showcase" class={active === 'showcase' ? 'active' : ''}><span class="ico">◫</span> Showcase</a>
          <a href="/docs" class={active === 'docs' ? 'active' : ''}><span class="ico">▤</span> Docs</a>
          <a href="https://github.com/0libote/HA-BPs" target="_blank" rel="noreferrer"><span class="ico">♡</span> GitHub</a>
        </nav>
        <div class="ha-side-foot">
          HA 2025.7+ · MIT licence<br />Deploys on Cloudflare Pages
        </div>
      </aside>
      <div class="ha-main">
        <div class="ha-topbar">
          <div>
            <div class="crumbs">{crumbs}</div>
            {heading && <h1>{heading}</h1>}
          </div>
          <div class="spacer"></div>
          <a class="ha-btn ghost" href="/showcase">Try showcase</a>
          <a class="ha-btn" href="/docs">Docs</a>
        </div>
        <div class="ha-content">
          <slot />
          <div class="footer">
            <span>0libote HA-BPs · MIT</span>
            <a href="https://github.com/0libote/HA-BPs">GitHub</a>
            <a href="https://www.home-assistant.io/" target="_blank" rel="noreferrer">Home Assistant</a>
            <span>Showcase is a replica with mock entities — import into HA for real devices.</span>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
