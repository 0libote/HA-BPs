---
import Icon from '../components/Icon.astro';
import '../styles/ha.css';

interface Props {
  title: string;
  active?: 'blueprints' | 'docs' | 'showcase';
  wide?: boolean;
}

const { title, active, wide = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Home Assistant blueprints for IKEA Matter devices. Import, read the docs, or try every setting in a working replica of HA's editor." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a class="wordmark" href="/">
          <span class="mark"><Icon name="home" size={15} sw={2.2} /></span>
          0libote <small>/ blueprints</small>
        </a>
        <nav class="site-nav">
          <a href="/" class={active === 'blueprints' ? 'active' : ''}>Blueprints</a>
          <a href="/showcase" class={active === 'showcase' ? 'active' : ''}>Showcase</a>
          <a href="/docs" class={active === 'docs' ? 'active' : ''}>Docs</a>
          <a href="https://github.com/0libote/HA-BPs" target="_blank" rel="noreferrer">GitHub <Icon name="arrowUpRight" size={13} /></a>
        </nav>
      </div>
    </header>
    <main class={`wrap${wide ? ' wide' : ''}`}>
      <slot />
      <footer class="site-footer">
        <span>0libote HA-BPs · MIT licence</span>
        <span class="spacer"></span>
        <span>Requires Home Assistant 2025.7+ · showcase runs on mock entities</span>
      </footer>
    </main>
  </body>
</html>
