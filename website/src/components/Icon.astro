---
import { paths } from './icons';

interface Props {
  name: string;
  size?: number;
  sw?: number;
}

const { name, size = 18, sw = 1.8 } = Astro.props;
const d = paths[name] ?? paths.sliders;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={sw}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  style="flex: none;"
>{d.map((p) => <path d={p} />)}</svg>
